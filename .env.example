# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Clerk (Dashboard -> API Keys) — publishable key only, safe to ship to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Comma-separated hostnames that should be treated as "real
# production" for search-indexing purposes (src/components/Seo/Seo.jsx)
# — any other hostname (a preview URL on whatever host you're on,
# staging, localhost) gets noindex,follow instead of being indexable.
# Defaults to the hostname in SITE_URL (src/data/businessInfo.js) if
# unset, which is correct for the one production domain with no config
# needed. Only set this if you serve production traffic from more than
# one hostname (e.g. both the apex and www domains).
# VITE_PRODUCTION_HOSTNAMES=www.torontobuffing.com,torontobuffing.com

# --- Server-only, used ONLY by scripts/seed-cms.mjs and scripts/import-redirects.mjs.
# Never prefix with VITE_ (a VITE_ prefix gets inlined into the browser bundle by Vite). ---

# Supabase Project Settings -> API -> service_role key (bypasses RLS, offline use only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Read at runtime by the Netlify Function/Edge Function adapters (netlify/functions/sitemap.js,
# netlify/edge-functions/redirects.js) — set these as real environment variables in your hosting
# provider's dashboard, not just in this local .env file, or the sitemap/redirects will silently
# fall back to static-only behavior in production. ---

# Same value as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above — Netlify Functions and Edge
# Functions read plain (non-VITE_-prefixed for Functions; Deno.env for Edge Functions) env vars,
# so the same two values need to exist under both names in your hosting provider's env var settings.

# Optional. Overrides the hardcoded production URL used to build absolute links in the sitemap
# (netlify/functions/sitemap.js). Defaults to https://www.torontobuffing.com if unset.
# SITE_URL=https://www.torontobuffing.com
